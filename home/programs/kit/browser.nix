# Default shortcuts of Firefox (Linux) and Chrome (Mac) for `kit keys`.
# Neither browser takes its shortcuts from this repo, so this is a hand-kept
# copy of their defaults, not generated config. null = no shortcut.
[
  {
    action = "New tab";
    firefox = "Ctrl+T";
    chrome = "Cmd+T";
  }
  {
    action = "Reopen closed tab";
    firefox = "Ctrl+Shift+T";
    chrome = "Cmd+Shift+T";
  }
  {
    action = "Close tab";
    firefox = "Ctrl+W";
    chrome = "Cmd+W";
  }
  {
    action = "New window";
    firefox = "Ctrl+N";
    chrome = "Cmd+N";
  }
  {
    action = "Close window";
    firefox = "Ctrl+Shift+W";
    chrome = "Cmd+Shift+W";
  }
  {
    action = "Private window";
    firefox = "Ctrl+Shift+P";
    chrome = "Cmd+Shift+N";
  }
  {
    action = "Next / previous tab";
    firefox = "Ctrl+Tab / Ctrl+Shift+Tab";
    chrome = "Ctrl+Tab / Ctrl+Shift+Tab";
  }
  {
    action = "Next / previous tab (alt)";
    firefox = "Ctrl+PgDn / Ctrl+PgUp";
    chrome = "Cmd+Alt+Right / Cmd+Alt+Left";
  }
  {
    action = "Tab 1-8 / last tab";
    firefox = "Alt+1..8 / Alt+9";
    chrome = "Cmd+1..8 / Cmd+9";
  }
  {
    action = "Move tab left / right";
    firefox = "Ctrl+Shift+PgUp / Ctrl+Shift+PgDn";
    chrome = null;
  }
  {
    action = "Back / forward";
    firefox = "Alt+Left / Alt+Right";
    chrome = "Cmd+[ / Cmd+]";
  }
  {
    action = "Address bar";
    firefox = "Ctrl+L";
    chrome = "Cmd+L";
  }
  {
    action = "Find / next / previous";
    firefox = "Ctrl+F / Ctrl+G / Ctrl+Shift+G";
    chrome = "Cmd+F / Cmd+G / Cmd+Shift+G";
  }
  {
    action = "Reload / bypass cache";
    firefox = "Ctrl+R / Ctrl+Shift+R";
    chrome = "Cmd+R / Cmd+Shift+R";
  }
  {
    action = "Zoom in / out / reset";
    firefox = "Ctrl+= / Ctrl+- / Ctrl+0";
    chrome = "Cmd+= / Cmd+- / Cmd+0";
  }
  {
    action = "Full screen";
    firefox = "F11";
    chrome = "Cmd+Ctrl+F";
  }
  {
    action = "Bookmark page";
    firefox = "Ctrl+D";
    chrome = "Cmd+D";
  }
  {
    action = "Bookmarks toolbar";
    firefox = "Ctrl+Shift+B";
    chrome = "Cmd+Shift+B";
  }
  {
    action = "Bookmarks sidebar";
    firefox = "Ctrl+B";
    chrome = null;
  }
  {
    action = "Bookmark manager";
    firefox = "Ctrl+Shift+O";
    chrome = "Cmd+Alt+B";
  }
  {
    action = "History";
    firefox = "Ctrl+H / Ctrl+Shift+H";
    chrome = "Cmd+Y";
  }
  {
    action = "Downloads";
    firefox = "Ctrl+Shift+Y";
    chrome = "Cmd+Shift+J";
  }
  {
    action = "Developer tools";
    firefox = "Ctrl+Shift+I";
    chrome = "Cmd+Alt+I";
  }
  {
    action = "Console";
    firefox = "Ctrl+Shift+K";
    chrome = "Cmd+Alt+J";
  }
  {
    action = "Page source";
    firefox = "Ctrl+U";
    chrome = "Cmd+Alt+U";
  }
  {
    action = "Print";
    firefox = "Ctrl+P";
    chrome = "Cmd+P";
  }
]
